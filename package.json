{
  "name": "@molecare/rn-trace",
  "version": "0.1.0",
  "description": "Find out why a tap did nothing: JS-thread stalls, slow tap-to-response, repeat taps and the props behind re-renders, for React Native and React. Plain TypeScript, no native code, readable in release builds.",
  "license": "Apache-2.0",
  "author": "MoleCare LTD <info@molecare.co.uk> (https://www.molecare.co.uk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoleCare/rn-trace.git"
  },
  "bugs": {
    "url": "https://github.com/MoleCare/rn-trace/issues"
  },
  "homepage": "https://github.com/MoleCare/rn-trace#readme",
  "keywords": [
    "react-native",
    "react",
    "debugging",
    "tracing",
    "performance",
    "js-thread",
    "event-loop-lag",
    "re-render",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./lib/typescript/module/src/react.d.ts",
        "default": "./lib/module/react.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/react.d.ts",
        "default": "./lib/commonjs/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "react",
    "src",
    "!**/__tests__",
    "!**/*.tsbuildinfo",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib coverage",
    "prepack": "bob build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "check:package": "bob build && publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "babel-jest": "^30.5.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts",
      "!<rootDir>/src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "publishConfig": {
    "access": "public"
  }
}
